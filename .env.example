# Copy to .env and adjust. Never commit .env — it is gitignored.

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_DNS=dns.events.raw

# ── QVAC (local inference only — see AGENTS.md §2 and §6) ───────────────────
# Path to the downloaded GGUF weights. Never committed: ~2.9 GB.
# A path with spaces works unquoted here — the scripts parse this file line by
# line rather than sourcing it, precisely because `source` would break on one.
QVAC_MODELS_DIR=./models
QVAC_TEXT_MODEL=qvac/MedPsy-4B-GGUF
QVAC_TEXT_QUANT=q4_k_m-imat
QVAC_VISION_MODEL=qvac/VisionPsy-Nano-460M-Flash-GGUFs
QVAC_VISION_QUANT=q4_k_m-imat

# ── Dev 3: ClickHouse / Grafana / Wazuh settings go here ────────────────────

# ── ClickHouse / Grafana ────────────────────────────────────────────────────
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DB=sentinel
# The ClickHouse container assigns `default` a random password unless these are
# set, so a client with no credentials fails in Docker but works natively.
CLICKHOUSE_USER=sentinel
CLICKHOUSE_PASSWORD=sentinel
GRAFANA_PASSWORD=sentinel
